{
  "name": "cgoit/contao-calendar-ical-bundle",
  "type": "contao-bundle",
  "description": "iCal support for calendar of Contao OpenSource CMS",
  "keywords": [
    "ical",
    "calendar",
    "contao"
  ],
  "version": "5.9.17",
  "license": "LGPL-3.0-or-later",
  "authors": [
    {
      "name": "Helmut Schottmüller",
      "homepage": "https://github.com/hschottm"
    },
    {
      "name": "Daniel Kiesel",
      "email": "daniel@craffft.de",
      "homepage": "http://craffft.de"
    },
    {
      "name": "Carsten Götzinger",
      "email": "info@cgo-it.de",
      "homepage": "https://cgo-it.de"
    }
  ],
  "support": {
    "issues": "https://github.com/cgoIT/contao-calendar-ical-bundle/issues",
    "source": "https://github.com/cgoIT/contao-calendar-ical-bundle"
  },
  "require": {
    "php": "^8.3",
    "ext-filter": "*",
    "ext-mbstring": "*",
    "contao/core-bundle": "^5.3",
    "contao/calendar-bundle": "^5.3",
    "doctrine/dbal": "^3.3 || ^4.0",
    "psr/log": "^1.1 || ^2.0 || ^3.0",
    "symfony/config": "^6.4 || ^7.3",
    "symfony/dependency-injection": "^6.4 || ^7.3",
    "symfony/deprecation-contracts": "^2.5 || ^3.0",
    "symfony/event-dispatcher": "^6.4 || ^7.3",
    "symfony/event-dispatcher-contracts": "^3.0",
    "symfony/filesystem": "^6.4 || ^7.3",
    "symfony/http-client": "^6.4 || ^7.3",
    "symfony/http-client-contracts": "^3.0",
    "symfony/http-foundation": "^6.4 || ^7.3",
    "symfony/http-kernel": "^6.4 || ^7.3",
    "symfony/routing": "^6.4 || ^7.3",
    "symfony/security-bundle": "^6.4 || ^7.3",
    "symfony/security-csrf": "^6.4 || ^7.3",
    "kigkonsult/icalcreator": "~2",
    "webignition/robots-txt-file": "^3.0"
  },
  "require-dev": {
    "contao/manager-plugin": "^2.0",
    "terminal42/contao-build-tools": "dev-main",
    "phpunit/phpunit": "^10.5 || ^11.5"
  },
  "conflict": {
    "contao/manager-plugin": "<2.0 || >=3.0"
  },
  "suggest": {
    "cgoit/calendar-extended-bundle": "to handle recurring and recurring exception dates"
  },
  "autoload": {
    "psr-4": {
      "Cgoit\\ContaoCalendarIcalBundle\\": "src/"
    },
    "files": [
      "config/compat.php"
    ]
  },
  "autoload-dev": {
    "psr-4": {
      "Cgoit\\ContaoCalendarIcalBundle\\Tests\\": "tests/"
    }
  },
  "config": {
    "allow-plugins": {
      "contao-components/installer": true,
      "contao/manager-plugin": true,
      "php-http/discovery": true,
      "terminal42/contao-build-tools": true
    }
  },
  "extra": {
    "contao-manager-plugin": "Cgoit\\ContaoCalendarIcalBundle\\ContaoManager\\Plugin"
  },
  "scripts": {
    "all": [
      "@fix-tools",
      "@tests"
    ],
    "tests": "phpunit"
  }
}
