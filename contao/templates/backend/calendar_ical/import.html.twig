{% extends '@Contao/be_main' %}

{% block main_content %}
    <div id="tl_buttons">
        <a href="{{ back_url }}" class="header_back" title="{{ 'MSC.backBTTitle'|trans({}, 'contao_default') }}" accesskey="b">{{ 'MSC.backBT'|trans({}, 'contao_default') }}</a>
    </div>

    {{ message|raw }}
    {% if has_errors %}
        <p class="tl_error">{{ 'ERR.submit'|trans({}, 'contao_default') }}</p>
    {% endif %}

    <form id="{{ table }}" class="tl_form tl_edit_form" method="post" enctype="multipart/form-data" data-turbo="false">
        <div class="tl_formbody_edit">
            <input type="hidden" name="FORM_SUBMIT" value="{{ table }}">
            <input type="hidden" name="REQUEST_TOKEN" value="{{ request_token }}">
            <input type="hidden" name="MAX_FILE_SIZE" value="{{ max_file_size }}">

            {% if info %}
                <p class="tl_info">{{ info }}</p>
            {% endif %}

            {% for box in boxes %}
                <fieldset id="pal_{{ box.key }}" class="tl_tbox{{ box.class ? ' ' ~ box.class }}{{ box.label ? '' : ' nolegend' }}">
                    {% if box.label %}
                        <legend>{{ box.label }}</legend>
                    {% endif %}
                    {% if uploader and loop.first %}
                        <div class="clr widget">
                            <h3>{{ upload_label[0] }}</h3>
                            {{ uploader|raw }}
                            {% if upload_label[1] is defined %}<p class="tl_help tl_tip">{{ upload_label[1] }}</p>{% endif %}
                        </div>
                    {% endif %}
                    {% for widget in box.widgets %}{{ widget|raw }}{% endfor %}
                </fieldset>
            {% endfor %}
        </div>

        <div class="tl_formbody_submit">
            <div class="tl_submit_container">
                <button type="submit" name="import" id="save" class="tl_submit" accesskey="s">{{ submit }}</button>
                {% if abort %}
                    <button type="submit" name="abort" class="tl_submit" formnovalidate>{{ abort }}</button>
                {% endif %}
            </div>
        </div>
    </form>
{% endblock %}
